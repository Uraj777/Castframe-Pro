# ============================================
# CASTFRAME-PRO Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# --------------------------------------------
# AI & API Keys
# --------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI (script generation, prompt enhancement)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# HF_TOKEN: HuggingFace token for Flux.1-dev image generation (optional fallback)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=""

# ELEVENLABS_API_KEY: ElevenLabs API key for premium TTS (optional)
# Get from: https://elevenlabs.io/app/settings
ELEVENLABS_API_KEY=""

# POLLINATIONS_KEY: Pollinations.ai doesn't require auth for free tier
# Leave empty or add if you have a premium key
POLLINATIONS_KEY=""

# --------------------------------------------
# Redis Configuration (for BullMQ job queue)
# --------------------------------------------
# Optional: For production async video rendering
# Local dev works without Redis (uses simulation mode)

REDIS_URL="redis://localhost:6379"
# Or use Redis Cloud: "redis://default:PASSWORD@HOST:PORT"

# --------------------------------------------
# Server Configuration
# --------------------------------------------

PORT=3000
NODE_ENV=development

# CORS: Comma-separated list of allowed origins
# For Medusa Android app, add your app's domain/IP
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Rate limiting (requests per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --------------------------------------------
# File Storage
# --------------------------------------------

# Directory for uploaded/generated media files
UPLOADS_DIR="./uploads"

# Public URL prefix for served media files
# Set to your CDN/storage URL in production
MEDIA_URL_PREFIX="/api/media"

# --------------------------------------------
# FFmpeg Configuration
# --------------------------------------------
# Path to ffmpeg binary (usually auto-detected)
# Only set if ffmpeg is not in your system PATH

FFMPEG_PATH=""
FFPROBE_PATH=""

# --------------------------------------------
# App URL (for callbacks and media links)
# --------------------------------------------
APP_URL="http://localhost:3000"

